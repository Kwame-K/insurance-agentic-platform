
# =============================================================================
# Project 1 — Insurance Submission Extractor
# =============================================================================

# Choose one provider: groq or gemini.
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_RETRIES=3

# Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# =============================================================================
# Project 3 — Insurance RAG Assistant
# =============================================================================

# Project 3 uses the same GROQ_API_KEY declared above.
GROQ_MODEL_NAME=openai/gpt-oss-20b


# =============================================================================
# Project 4 — Underwriting Agent
# =============================================================================

# Timeout for Project 4 -> Project 1 HTTP requests.
SUBMISSION_EXTRACTOR_TIMEOUT_SECONDS=30

# Timeout for Project 4 -> Project 3 HTTP requests.
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Shared PostgreSQL (pgvector:pg17)
# -----------------------------------------------------------------------------
POSTGRES_SUPERUSER=platform_admin
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_PORT=5432

# Each application receives only its own password and database URL.
EXTRACTOR_DB_PASSWORD=
UNDERWRITING_DB_PASSWORD=
KNOWLEDGE_DB_PASSWORD=
ANALYST_DB_PASSWORD=



# =============================================================================
# Project 5 — Email Intake
# =============================================================================
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER= # change to your email
IMAP_PASSWORD= # change to your password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=30
IMAP_ALLOWED_SENDERS= # change to your email

SMTP_REPLY_ENABLED=true
REPLY_LANGUAGE=en
# Copy to .env, then replace every placeholder with a unique secret.
# Never commit .env.

# -----------------------------------------------------------------------------
# Shared PostgreSQL (pgvector:pg17)
# -----------------------------------------------------------------------------
POSTGRES_SUPERUSER=platform_admin
POSTGRES_SUPERUSER_PASSWORD=change-me-to-a-long-random-admin-password
POSTGRES_PORT=5432

# Each application receives only its own password and database URL.
EXTRACTOR_DB_PASSWORD=change-me-to-a-long-random-extractor-password
UNDERWRITING_DB_PASSWORD=change-me-to-a-long-random-underwriting-password
KNOWLEDGE_DB_PASSWORD=change-me-to-a-long-random-knowledge-password

# -----------------------------------------------------------------------------
# Project 1 — Insurance Submission Extractor
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_RETRIES=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# -----------------------------------------------------------------------------
# Project 3 — Insurance RAG Assistant
# -----------------------------------------------------------------------------
GROQ_MODEL_NAME=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Project 4 — Underwriting Agent (still uses local SQLite at this stage)
# -----------------------------------------------------------------------------
SUBMISSION_EXTRACTOR_TIMEOUT_SECONDS=30
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=10
